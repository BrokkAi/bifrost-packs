                              (call :callee (name "Match") :arity 3))))))))
              :dangerous-operand (argument :index 1)
              :accepts [untrusted])
            (sink
              :id regex-matches-pattern
              :display-name "Regex.Matches(String, String) pattern"
              :categories [regex.pattern]
              :selector
                (rql
                  :schema-version 1
                  (language csharp
                    (call-argument :formal-index 1
                      (resolved-call
                        :resolves-to "System.Text.RegularExpressions.Regex.Matches"
                        :proof declared
                        (filter :where
                          ((model_id eq "member.dotnet.system-text-regularexpressions-csharp.regex.matches-static-pattern"))
                          (call-bindings
                            (call-shape
                              (call :callee (name "Matches") :arity 2))))))))
              :dangerous-operand (argument :index 1)
              :accepts [untrusted])
            (sink
              :id regex-matches-pattern-options
              :display-name "Regex.Matches(String, String, RegexOptions) pattern"
              :categories [regex.pattern]
              :selector
                (rql
                  :schema-version 1
                  (language csharp
                    (call-argument :formal-index 1
                      (resolved-call
                        :resolves-to "System.Text.RegularExpressions.Regex.Matches"
                        :proof declared
                        (filter :where
                          ((model_id eq "member.dotnet.system-text-regularexpressions-csharp.regex.matches-static-pattern-options"))
                          (call-bindings
                            (call-shape
                              (call :callee (name "Matches") :arity 3))))))))
              :dangerous-operand (argument :index 1)
              :accepts [untrusted])
            (sink
              :id regex-split-pattern
              :display-name "Regex.Split(String, String) pattern"
              :categories [regex.pattern]
              :selector
                (rql
                  :schema-version 1
                  (language csharp
                    (call-argument :formal-index 1
                      (resolved-call
                        :resolves-to "System.Text.RegularExpressions.Regex.Split"
                        :proof declared
                        (filter :where
                          ((model_id eq "member.dotnet.system-text-regularexpressions-csharp.regex.split-static-pattern"))
                          (call-bindings
                            (call-shape
                              (call :callee (name "Split") :arity 2))))))))
              :dangerous-operand (argument :index 1)
              :accepts [untrusted])
            (sink
              :id regex-split-pattern-options
              :display-name "Regex.Split(String, String, RegexOptions) pattern"
              :categories [regex.pattern]
              :selector
                (rql
                  :schema-version 1
                  (language csharp
                    (call-argument :formal-index 1
                      (resolved-call
                        :resolves-to "System.Text.RegularExpressions.Regex.Split"
                        :proof declared
                        (filter :where
                          ((model_id eq "member.dotnet.system-text-regularexpressions-csharp.regex.split-static-pattern-options"))
                          (call-bindings
                            (call-shape
                              (call :callee (name "Split") :arity 3))))))))
              :dangerous-operand (argument :index 1)
              :accepts [untrusted])
            (sink
              :id regex-replace-pattern
              :display-name "Regex.Replace(String, String, String) pattern"
              :categories [regex.pattern]
              :selector
                (rql
                  :schema-version 1
                  (language csharp
                    (call-argument :formal-index 1
                      (resolved-call
                        :resolves-to "System.Text.RegularExpressions.Regex.Replace"
                        :proof declared
                        (filter :where
                          ((model_id eq "member.dotnet.system-text-regularexpressions-csharp.regex.replace-static-pattern"))
                          (call-bindings
                            (call-shape
                              (call :callee (name "Replace") :arity 3))))))))
              :dangerous-operand (argument :index 1)
              :accepts [untrusted])
            (sink
              :id regex-replace-pattern-options
              :display-name "Regex.Replace(String, String, String, RegexOptions) pattern"
              :categories [regex.pattern]
              :selector
                (rql
                  :schema-version 1
                  (language csharp
                    (call-argument :formal-index 1
                      (resolved-call
                        :resolves-to "System.Text.RegularExpressions.Regex.Replace"
                        :proof declared
                        (filter :where
                          ((model_id eq "member.dotnet.system-text-regularexpressions-csharp.regex.replace-static-pattern-options"))
                          (call-bindings
                            (call-shape
                              (call :callee (name "Replace") :arity 4))))))))
              :dangerous-operand (argument :index 1)
              :accepts [untrusted])])
      :sanitizers
        (endpoint-set
          :entries [
            (sanitizer
              :id regex-escape
              :selector
                (rql
                  :schema-version 1
                  (language csharp
                    (resolved-call
                      :resolves-to "System.Text.RegularExpressions.Regex.Escape"
                      :proof declared
                      (call-bindings
                        (call-shape
                          (call :callee (name "Escape") :arity 1))))))
              :input (argument :index 0)
              :output return-value
              :removes [untrusted])]))
  :classification
    (classification
      :fallback (classification-id :taxonomy "CWE" :id "1333")))
