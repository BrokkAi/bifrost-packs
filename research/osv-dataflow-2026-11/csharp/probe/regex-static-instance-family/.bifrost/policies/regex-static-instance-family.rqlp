; Research probe for bifrost-dev#9982 (lead BrokkAi/bifrost-packs#263), not pack
; content. The shipped regex-pattern-injection policy, run against its model plus
; the instance Regex.IsMatch(String) overload: every static IsMatch selector fails
; with qualified-call-locator-ambiguous.
(policy
  :schema-version 1
  :id "bifrost.research.csharp.regex-static-instance-family"
  :name "C# external input used as a regular-expression pattern without a timeout"
  :message "external input is used as a Regex pattern with no match timeout"
  :severity warning
  :description "Reports Console.ReadLine and Environment.GetEnvironmentVariable data reaching the pattern operand of the Regex(String) and Regex(String, RegexOptions) constructors, or of the static Regex.IsMatch, Match, Matches, Split and Replace overloads that take no matchTimeout, in the reviewed System.Text.RegularExpressions model, unless Regex.Escape removes the untrusted label. A caller-written pattern can backtrack catastrophically (CVE-2019-0820, CWE-1333) on any runtime unless a match timeout bounds it, so overloads that take a matchTimeout are not reported."
  :tags ["security" "csharp" "regex" "redos" "cwe-1333" "cwe-730"]
  :analysis
    (analysis
      :type taint
      :mode may
      :call-modeling (call-modeling :unmodeled require-model)
      :sources
        (endpoint-set
          :entries [
            (source
              :id console-read-line
              :display-name "Console.ReadLine external input"
              :categories [input.user-controlled io.external]
              :selector
                (rql
                  :schema-version 1
                  (language csharp
                    (resolved-call
                      :resolves-to "System.Console.ReadLine"
                      :proof declared
                      (call-bindings
                        (call-shape
                          (call :callee (name "ReadLine") :arity 0))))))
              :bind return-value
              :labels [untrusted])
            (source
              :id environment-get-environment-variable
              :display-name "Environment.GetEnvironmentVariable external input"
              :categories [input.user-controlled io.external]
              :selector
                (rql
                  :schema-version 1
                  (language csharp
                    (resolved-call
                      :resolves-to "System.Environment.GetEnvironmentVariable"
                      :proof declared
                      (call-bindings
                        (call-shape
                          (call :callee (name "GetEnvironmentVariable") :arity 1))))))
              :bind return-value
              :labels [untrusted])])
      :sinks
        (endpoint-set
          :entries [
            (sink
              :id regex-constructor-pattern
              :display-name "new Regex(String) pattern"
              :categories [regex.pattern]
              :selector
                (rql
                  :schema-version 1
                  (language csharp
                    (call-argument :formal-index 0
                      (resolved-call
                        :resolves-to "System.Text.RegularExpressions.Regex.Regex"
                        :proof declared
                        (filter :where
                          ((model_id eq "member.dotnet.system-text-regularexpressions-csharp.regex.constructor-pattern"))
                          (call-bindings
                            (call-shape
                              (call :callee (name "Regex") :arity 1))))))))
              :dangerous-operand (argument :index 0)
              :accepts [untrusted])
            (sink
              :id regex-constructor-pattern-options
              :display-name "new Regex(String, RegexOptions) pattern"
              :categories [regex.pattern]
              :selector
                (rql
                  :schema-version 1
                  (language csharp
                    (call-argument :formal-index 0
                      (resolved-call
                        :resolves-to "System.Text.RegularExpressions.Regex.Regex"
                        :proof declared
                        (filter :where
                          ((model_id eq "member.dotnet.system-text-regularexpressions-csharp.regex.constructor-pattern-options"))
                          (call-bindings
                            (call-shape
                              (call :callee (name "Regex") :arity 2))))))))
              :dangerous-operand (argument :index 0)
              :accepts [untrusted])
            (sink
              :id regex-is-match-pattern
              :display-name "Regex.IsMatch(String, String) pattern"
              :categories [regex.pattern]
              :selector
                (rql
                  :schema-version 1
                  (language csharp
                    (call-argument :formal-index 1
                      (resolved-call
                        :resolves-to "System.Text.RegularExpressions.Regex.IsMatch"
                        :proof declared
                        (filter :where
                          ((model_id eq "member.dotnet.system-text-regularexpressions-csharp.regex.is-match-static-pattern"))
                          (call-bindings
                            (call-shape
                              (call :callee (name "IsMatch") :arity 2))))))))
              :dangerous-operand (argument :index 1)
              :accepts [untrusted])
            (sink
              :id regex-is-match-pattern-options
              :display-name "Regex.IsMatch(String, String, RegexOptions) pattern"
              :categories [regex.pattern]
              :selector
                (rql
                  :schema-version 1
                  (language csharp
                    (call-argument :formal-index 1
                      (resolved-call
                        :resolves-to "System.Text.RegularExpressions.Regex.IsMatch"
                        :proof declared
                        (filter :where
                          ((model_id eq "member.dotnet.system-text-regularexpressions-csharp.regex.is-match-static-pattern-options"))
                          (call-bindings
                            (call-shape
                              (call :callee (name "IsMatch") :arity 3))))))))
              :dangerous-operand (argument :index 1)
              :accepts [untrusted])
            (sink
              :id regex-match-pattern
              :display-name "Regex.Match(String, String) pattern"
              :categories [regex.pattern]
              :selector
                (rql
                  :schema-version 1
                  (language csharp
                    (call-argument :formal-index 1
                      (resolved-call
                        :resolves-to "System.Text.RegularExpressions.Regex.Match"
                        :proof declared
                        (filter :where
                          ((model_id eq "member.dotnet.system-text-regularexpressions-csharp.regex.match-static-pattern"))
                          (call-bindings
                            (call-shape
                              (call :callee (name "Match") :arity 2))))))))
              :dangerous-operand (argument :index 1)
              :accepts [untrusted])
            (sink
              :id regex-match-pattern-options
              :display-name "Regex.Match(String, String, RegexOptions) pattern"
              :categories [regex.pattern]
              :selector
                (rql
                  :schema-version 1
                  (language csharp
                    (call-argument :formal-index 1
                      (resolved-call
                        :resolves-to "System.Text.RegularExpressions.Regex.Match"
                        :proof declared
                        (filter :where
