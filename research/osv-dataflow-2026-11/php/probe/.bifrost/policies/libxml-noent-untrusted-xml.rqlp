; Research probe for libxml-noent-untrusted-xml. Not registered pack content.
(policy
  :schema-version 1
  :id "research.php-osv.libxml-noent-untrusted-xml"
  :name "request XML parsed by simplexml_load_string with LIBXML_NOENT (research probe)"
  :message "request XML parsed by simplexml_load_string with LIBXML_NOENT"
  :severity warning
  :description "Research probe for the PHP OSV data-flow lead libxml-noent-untrusted-xml."
  :tags ["research" "php"]
  :analysis (analysis
    :type taint
    :mode may
    :call-modeling (call-modeling :unmodeled require-model)
    :sources (endpoint-set :entries [
      (source :id request-param :display-name "request parameter" :categories [input.user-controlled]
        :selector (rql :schema-version 1 (language php (call-sites-to :proof proven (enclosing-decl (function :name "request_param")))))
        :bind return-value :labels [untrusted])])
    :sinks (endpoint-set :entries [
      (sink :id simplexml-noent :display-name "simplexml-noent" :categories [x] :selector (rql :schema-version 1 (language php (call-argument :formal-index 0 (resolved-call :resolves-to "_php_global_.simplexml_load_string" :proof declared (call-bindings (call-shape (call :callee (name "simplexml_load_string") :args [(capture "data") (capture "class") (name "LIBXML_NOENT")]))))))) :dangerous-operand (argument :index 0) :accepts [untrusted])])))
