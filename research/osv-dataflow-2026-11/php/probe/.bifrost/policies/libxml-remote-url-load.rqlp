; Research probe for libxml-remote-url-load. Not registered pack content.
(policy
  :schema-version 1
  :id "research.php-osv.libxml-remote-url-load"
  :name "request URL loaded as XML by simplexml_load_file (research probe)"
  :message "request URL loaded as XML by simplexml_load_file"
  :severity warning
  :description "Research probe for the PHP OSV data-flow lead libxml-remote-url-load."
  :tags ["research" "php"]
  :analysis (analysis
    :type taint
    :mode may
    :call-modeling (call-modeling :unmodeled require-model)
    :sources (endpoint-set :entries [
      (source :id request-param :display-name "request parameter" :categories [input.user-controlled]
        :selector (rql :schema-version 1 (language php (call-sites-to :proof proven (enclosing-decl (function :name "request_param")))))
        :bind return-value :labels [untrusted])])
    :sinks (endpoint-set :entries [
      (sink :id simplexml-load-file :display-name "simplexml-load-file" :categories [x] :selector (rql :schema-version 1 (language php (call-argument :formal-index 0 (resolved-call :resolves-to "_php_global_.simplexml_load_file" :proof declared (call-bindings (call-shape (call :callee (name "simplexml_load_file")))))))) :dangerous-operand (argument :index 0) :accepts [untrusted])])))
