; Research probe for fsockopen-host-after-check. Not registered pack content.
(policy
  :schema-version 1
  :id "research.php-osv.fsockopen-host-after-check"
  :name "request host reaches fsockopen after a parse_url check (research probe)"
  :message "request host reaches fsockopen after a parse_url check"
  :severity warning
  :description "Research probe for the PHP OSV data-flow lead fsockopen-host-after-check."
  :tags ["research" "php"]
  :analysis (analysis
    :type taint
    :mode may
    :call-modeling (call-modeling :unmodeled require-model)
    :sources (endpoint-set :entries [
      (source :id request-param :display-name "request parameter" :categories [input.user-controlled]
        :selector (rql :schema-version 1 (language php (call-sites-to :proof proven (enclosing-decl (function :name "request_param")))))
        :bind return-value :labels [untrusted])])
    :sinks (endpoint-set :entries [
      (sink :id fsockopen-host :display-name "fsockopen-host" :categories [x] :selector (rql :schema-version 1 (language php (call-argument :formal-index 0 (resolved-call :resolves-to "_php_global_.fsockopen" :proof declared (call-bindings (call-shape (call :callee (name "fsockopen")))))))) :dangerous-operand (argument :index 0) :accepts [untrusted])])))
