(policy
  :schema-version 1
  :id "research.java.servlet-parameter-to-jndi-raw-filter"
  :name "Servlet parameter reaches a raw JNDI LDAP search filter"
  :message "A servlet request parameter reached the raw filter of DirContext.search(String, String, SearchControls)"
  :severity error
  :description "Research probe for BrokkAi/bifrost-packs#300."
  :tags ["security" "java" "ldap-injection" "cwe-90"]
  :analysis
    (analysis
      :type taint
      :mode may
      :call-modeling (call-modeling :unmodeled require-model)
      :sources
        (endpoint-set
          :entries [
            (source
              :id servlet-request-parameter
              :display-name "ServletRequest.getParameter(String)"
              :categories [input.user-controlled io.external]
              :selector
                (rql
                  :schema-version 1
                  (language java
                    (call-argument :formal-name "name"
                      (resolved-call
                        :resolves-to member.servletrequest.getparameter
                        :proof declared
                        (call-bindings
                          (call-shape
                            (call :callee (name "getParameter") (arity 1))))))))
              :bind return-value
              :labels [attacker-controlled])])
      :sinks
        (endpoint-set
          :entries [
            (sink
              :id dircontext-search-raw-filter
              :display-name "DirContext.search(String, String, SearchControls) filter"
              :categories [ldap.filter]
              :selector
                (rql
                  :schema-version 1
                  (language java
                    (call-argument :formal-index 1
                      (resolved-call
                        :resolves-to member.4d14ca0aad5d96b889327230aa81549a43fa4628493745d0512c94d091048cef
                        :proof declared
                        (call-bindings
                          (call-shape
                            (call :callee (name "search") (arity 3))))))))
              :dangerous-operand (argument :index 1)
              :accepts [attacker-controlled])]))
  :classification
    (classification
      :fallback (classification-id :taxonomy "CWE" :id "90")))
