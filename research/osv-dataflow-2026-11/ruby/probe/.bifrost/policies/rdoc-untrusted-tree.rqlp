;; Research probe for BrokkAi/bifrost-packs#285. Network bytes from
;; Net::HTTP.get reaching formal 0 of RDoc::RDoc.document. Not registered pack content.
(policy
  :schema-version 1
  :id "research.ruby-osv-dataflow.rdoc-untrusted-tree"
  :name "Ruby network bytes reach RDoc::RDoc.document (research probe)"
  :message "bytes from Net::HTTP.get reach RDoc::RDoc.document"
  :severity warning
  :description "Research probe for BrokkAi/bifrost-packs#285. Reports the Net::HTTP.get response body reaching formal 0 of RDoc::RDoc.document."
  :tags ["research" "ruby"]
  :analysis (analysis
    :type taint
    :mode may
    :call-modeling (call-modeling :unmodeled require-model)
    :sources (endpoint-set :entries [
      (source :id net-http-get :display-name "Net::HTTP.get body" :categories [io.external]
        :selector (rql :schema-version 1
          (language ruby (resolved-call :resolves-to "Net::HTTP.get" :proof declared
            (call-bindings (call-shape (call :callee (name "get")))))))
        :bind return-value :labels [untrusted])])
    :sinks (endpoint-set :entries [
      (sink :id sink :display-name "RDoc::RDoc#document argv" :categories [injection]
        :selector (rql :schema-version 1
          (language ruby (call-argument :formal-index 0
            (resolved-call :resolves-to "RDoc::RDoc.document" :proof declared
              (call-bindings (call-shape (call :callee (name "document"))))))))
        :dangerous-operand (argument :index 0) :accepts [untrusted])])))
