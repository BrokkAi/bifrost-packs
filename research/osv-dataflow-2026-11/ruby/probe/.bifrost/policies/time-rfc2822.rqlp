;; Research probe for BrokkAi/bifrost-packs#280. Network bytes from
;; Net::HTTP.get reaching formal 0 of Time.rfc2822. Not registered pack content.
(policy
  :schema-version 1
  :id "research.ruby-osv-dataflow.time-rfc2822"
  :name "Ruby network bytes reach Time.rfc2822 (research probe)"
  :message "bytes from Net::HTTP.get reach Time.rfc2822"
  :severity warning
  :description "Research probe for BrokkAi/bifrost-packs#280. Reports the Net::HTTP.get response body reaching formal 0 of Time.rfc2822."
  :tags ["research" "ruby"]
  :analysis (analysis
    :type taint
    :mode may
    :call-modeling (call-modeling :unmodeled require-model)
    :sources (endpoint-set :entries [
      (source :id net-http-get :display-name "Net::HTTP.get body" :categories [io.external]
        :selector (rql :schema-version 1
          (language ruby (resolved-call :resolves-to "Net::HTTP.get" :proof declared
            (call-bindings (call-shape (call :callee (name "get")))))))
        :bind return-value :labels [untrusted])])
    :sinks (endpoint-set :entries [
      (sink :id sink :display-name "Time.rfc2822 date" :categories [injection]
        :selector (rql :schema-version 1
          (language ruby (call-argument :formal-index 0
            (resolved-call :resolves-to "Time.rfc2822" :proof declared
              (call-bindings (call-shape (call :callee (name "rfc2822"))))))))
        :dangerous-operand (argument :index 0) :accepts [untrusted])])))
