;; Research probe for BrokkAi/bifrost-packs#284. Network bytes from
;; Net::HTTP.get reaching formal 0 of Net::IMAP.new. Not registered pack content.
(policy
  :schema-version 1
  :id "research.ruby-osv-dataflow.net-imap-untrusted-server"
  :name "Ruby network bytes reach Net::IMAP.new (research probe)"
  :message "bytes from Net::HTTP.get reach Net::IMAP.new"
  :severity warning
  :description "Research probe for BrokkAi/bifrost-packs#284. Reports the Net::HTTP.get response body reaching formal 0 of Net::IMAP.new."
  :tags ["research" "ruby"]
  :analysis (analysis
    :type taint
    :mode may
    :call-modeling (call-modeling :unmodeled require-model)
    :sources (endpoint-set :entries [
      (source :id net-http-get :display-name "Net::HTTP.get body" :categories [io.external]
        :selector (rql :schema-version 1
          (language ruby (resolved-call :resolves-to "Net::HTTP.get" :proof declared
            (call-bindings (call-shape (call :callee (name "get")))))))
        :bind return-value :labels [untrusted])])
    :sinks (endpoint-set :entries [
      (sink :id sink :display-name "Net::IMAP.new host" :categories [injection]
        :selector (rql :schema-version 1
          (language ruby (call-argument :formal-index 0
            (resolved-call :resolves-to "Net::IMAP.new" :proof declared
              (call-bindings (call-shape (call :callee (name "new"))))))))
        :dangerous-operand (argument :index 0) :accepts [untrusted])])))
