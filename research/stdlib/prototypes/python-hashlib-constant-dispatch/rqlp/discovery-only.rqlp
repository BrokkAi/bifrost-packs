; Discovery only. Literal algorithm names and import spelling do not prove
; CPython stdlib module identity, constructor availability, or performance.
(policy
  :schema-version 1
  :id "research.discovery.python-hashlib-new-constant-dispatch"
  :name "Python hashlib.new constant-algorithm discovery"
  :message "Review this constant hash-algorithm call shape"
  :severity note
  :description "Syntactic discovery only: this may include local lookalikes and unrelated callables. It proves neither stdlib identity nor an optimization benefit."
  :tags ["research" "discovery-only" "python"]
  :analysis
    (analysis
      :type match
      :selector
        (rql
          :schema-version 1
          (language python
            (where "fixtures/hashlib_cases.py"
              (union
                (call
                  :callee (name "new")
                  :receiver (identifier)
                  :arity 2
                  :args [
                    (string_literal :text/regex "^[\\\"'](sha1|sha224|sha256|sha384|sha512|sha3_224|sha3_256|sha3_384|sha3_512|shake_128|shake_256|blake2b|blake2s)[\\\"']$")
                    (capture "data")])
                (call
                  :callee (name "new")
                  :receiver (identifier)
                  :arity 1
                  :args [
                    (string_literal :text/regex "^[\\\"'](sha1|sha224|sha256|sha384|sha512|sha3_224|sha3_256|sha3_384|sha3_512|shake_128|shake_256|blake2b|blake2s)[\\\"']$")])
                (call
                  :callee (identifier :capture "callee")
                  :arity 2
                  :args [
                    (string_literal :text/regex "^[\\\"'](sha1|sha224|sha256|sha384|sha512|sha3_224|sha3_256|sha3_384|sha3_512|shake_128|shake_256|blake2b|blake2s)[\\\"']$")
                    (capture "data")])
                (call
                  :callee (identifier :capture "callee")
                  :arity 1
                  :args [
                    (string_literal :text/regex "^[\\\"'](sha1|sha224|sha256|sha384|sha512|sha3_224|sha3_256|sha3_384|sha3_512|shake_128|shake_256|blake2b|blake2s)[\\\"']$")])
                (call
                  :callee (name "new")
                  :receiver (identifier)
                  :arity 0
                  :kwargs [
                    (name
                      (string_literal :text/regex "^[\\\"'](sha1|sha224|sha256|sha384|sha512|sha3_224|sha3_256|sha3_384|sha3_512|shake_128|shake_256|blake2b|blake2s)[\\\"']$"))])
                (call
                  :callee (identifier :capture "callee")
                  :arity 0
                  :kwargs [
                    (name
                      (string_literal :text/regex "^[\\\"'](sha1|sha224|sha256|sha384|sha512|sha3_224|sha3_256|sha3_384|sha3_512|shake_128|shake_256|blake2b|blake2s)[\\\"']$"))])))))))
