; Research probe for php-runtime-deserialization. Bytes read from a
; stream_socket_client connection reaching unserialize. Not registered pack
; content.
(policy
  :schema-version 1
  :id "research.php-stdlib.unserialize-network"
  :name "PHP network bytes reach unserialize (research probe)"
  :message "bytes from a stream_socket_client connection reach unserialize"
  :severity warning
  :description "Research probe. Reports a stream_socket_client connection whose bytes reach the data operand of unserialize."
  :tags ["research" "php" "deserialization" "cwe-502"]
  :analysis (analysis
    :type taint
    :mode may
    :call-modeling (call-modeling :unmodeled require-model)
    :sources (endpoint-set :entries [
      (source :id socket-client :display-name "stream_socket_client connection" :categories [io.external]
        :selector (rql :schema-version 1
          (language php (resolved-call :resolves-to "_php_global_.stream_socket_client" :proof declared
            (call-bindings (call-shape (call :callee (name "stream_socket_client")))))))
        :bind return-value :labels [untrusted])])
    :sinks (endpoint-set :entries [
      (sink :id unserialize :display-name "unserialize data" :categories [deserialization]
        :selector (rql :schema-version 1
          (language php (call-argument :formal-index 0
            (resolved-call :resolves-to "_php_global_.unserialize" :proof declared
              (call-bindings (call-shape (call :callee (name "unserialize"))))))))
        :dangerous-operand (argument :index 0) :accepts [untrusted])])))
