(policy
  :schema-version 1
  :id "bifrost.rust.filesystem-expect"
  :name "Expect on fallible filesystem operation"
  :message "Review whether this filesystem failure should propagate instead of panicking"
  :severity note
  :description "An expect directly consumes a read_dir or remove_file result. Filesystem state can change and failure may be recoverable. This is a structural review prompt; a deliberate fatal invariant can justify the panic."
  :tags ["rust" "filesystem" "error-handling"]
  :analysis
    (analysis
      :type match
      :selector
        (rql :schema-version 1
          (language rust
            (union
              (call :callee (name "expect") :receiver (call :callee (name "read_dir")))
              (call :callee (name "expect") :receiver (call :callee (name "remove_file"))))))))
