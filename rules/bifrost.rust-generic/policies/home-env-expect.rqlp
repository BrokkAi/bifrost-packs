(policy
  :schema-version 1
  :id "bifrost.rust.home-env-expect"
  :name "Expect on a var call for a home-directory key"
  :message "Review whether this var call for a home-directory key can fail"
  :severity note
  :description "An expect directly consumes a call named var with a HOME or USERPROFILE string argument. This name-based prompt does not prove std::env::var identity; review the callee and whether a missing value should be handled."
  :tags ["rust" "environment" "portability"]
  :analysis
    (analysis
      :type match
      :selector
        (rql :schema-version 1
          (language rust
            (call :callee (name "expect")
                  :receiver (call :callee (name "var")
                                  :args [(string_literal :string-value/regex "^(HOME|USERPROFILE)$")]))))))
