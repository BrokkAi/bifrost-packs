; CodeQL java/ql/src/Advisory/Declarations/MissingOverrideAnnotation.ql.
; CodeQL commit: ae741615f3e178ce61289a651790dc67fcc18e19
; Authored RQL implementation; no upstream query or fixture source is copied.
; Family rows bridge declaration ids to member ids and carry each member's
; coverage to the run: an unread supertype makes the run inconclusive instead of
; clean. An incomplete family keeps its established edges, so no outcome filter.
; Annotated methods cannot be findings, so no binding selects them.
; Edge rows: filter forward relations, never inverse edges.
; Java decorator names are structurally normalized to their final identifier.
(policy
  :schema-version 1
  :id "bifrost.java-codeql-quality.missing-override-annotation"
  :name "Missing Override annotation"
  :message "This method overrides a superclass or interface method; it is advisable to add an Override annotation."
  :severity warning
  :description "Reports source methods with an established override or interface implementation that lack an Override annotation. Functional expressions and compiler-generated constructs are outside the Java method declaration selection."
  :tags ["java" "codeql" "quality" "maintainability" "readability" "java/missing-override-annotation"]
  :analysis (analysis
    :type assertion
    :languages [java]
    (bind :name method-declaration
      :query (rql :schema-version 1
        (language java
          (enclosing-decl
            (method (not-has (decorator :name "Override")))))))
    (bind :name family
      :query (rql :schema-version 1
        (language java
          (member-family
            (enclosing-decl
              (method (not-has (decorator :name "Override"))))))))
    (bind :name edge
      :query (rql :schema-version 1
        (filter :where ((relation in [overrides implements]))
          (language java
            (family-edges
              (enclosing-decl
                (method (not-has (decorator :name "Override")))))))))
    (join :left method-declaration :right family
      :on ((id member_declaration_id)))
    (join :left family :right edge
      :on ((member_id member_id)))
    (group :name by-method :by (method-declaration.id)
      (aggregate :name overrides :op count))
    (assert :group by-method :value overrides :cardinality (exactly 0)))
  :classification (classification
    :fallback (classification-id :taxonomy "CodeQL" :id "java/missing-override-annotation")))
