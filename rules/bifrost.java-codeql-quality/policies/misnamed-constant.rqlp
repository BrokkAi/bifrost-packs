; CodeQL java/ql/src/Advisory/Naming/NamingConventionsConstants.ql.
; CodeQL commit: ae741615f3e178ce61289a651790dc67fcc18e19
; Engine contract: report immutable static-final fields with lowercase names,
; excluding serialVersionUID.
(policy
  :schema-version 1
  :id "bifrost.java-codeql-quality.misnamed-constant"
  :name "Java misnamed constant"
  :message "constant name should use uppercase letters"
  :severity warning
  :description "Mirrors the reviewed CodeQL Java query at commit ae741615f3e178ce61289a651790dc67fcc18e19. Select Java constant declaration names containing lowercase letters."
  :tags ["java" "codeql" "quality"]
  :analysis (analysis :type match :selector
    (rql :schema-version 1
      (language java
        (identifier
          :name/regex ".*[a-z].*"
          :language-rule "java/misnamed-constant")))))
