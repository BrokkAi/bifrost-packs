; CodeQL: python/ql/src/Expressions/WrongNameForArgumentInCall.ql
; Source commit: ae741615f3e178ce61289a651790dc67fcc18e19
; Contract: report function and method keyword actuals proven to have no matching formal.
(policy
  :schema-version 1
  :id "bifrost.python-codeql-quality.call-wrong-named-argument"
  :name "Python call keyword has no matching parameter"
  :message "keyword argument does not match a callable parameter"
  :severity error
  :description "Mirrors CodeQL py/call/wrong-named-argument at ae741615f3e178ce61289a651790dc67fcc18e19. Reports only function and method call-binding rows classified as unknown keywords; constructor calls are handled separately and unresolved dispatch remains incomplete."
  :tags ["python" "codeql" "quality" "correctness"]
  :analysis (analysis
    :type assertion
    (bind :name mismatch
      :query (rql :schema-version 1
        (filter :where ((reason eq unknown_keyword))
          (call-bindings
            (filter :where ((call_kind in [function method]))
              (call-shape (language python (call))))))))
    (group :name by-site :by (mismatch.site_ast_id)
      (aggregate :name violations :op count))
    (assert :group by-site :value violations :cardinality (exactly 0))))
