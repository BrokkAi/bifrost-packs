; CodeQL: python/ql/src/Expressions/IncorrectComparisonUsingIs.ql
; Source commit: ae741615f3e178ce61289a651790dc67fcc18e19
; Contract: flag is/is-not comparisons when resolved operands use value equality,
; excluding singleton identity checks, identity-only classes, and CPython-interned literals.
(policy
  :schema-version 1
  :id "bifrost.python-codeql-quality.comparison-using-is"
  :name "Python comparison using is"
  :message "Use value equality for these operands."
  :severity warning
  :description "Identity comparison is suspicious when supported operands use value equality; singleton checks, identity-only classes, and literals CodeQL treats as interned are excluded."
  :tags ["python" "codeql" "quality" "correctness"]
  :analysis (analysis
    :type match
    :selector (rql :schema-version 1
      (except
        (language python (python-comparison-using-is (comparison)))
        (union
          (language python
            (comparison :left
              (string_literal (value/regex "(?s)^(?:|[\\x00-\\x{FF}])$"))))
          (language python
            (comparison :right
              (string_literal (value/regex "(?s)^(?:|[\\x00-\\x{FF}])$"))))
          (language python
            (comparison :left (tuple_literal :elements [])))
          (language python
            (comparison :right (tuple_literal :elements [])))
          (language python
            (comparison :left
              (numeric_literal
                (text/regex "^(?:0|[1-9](?:_?[0-9])?|1(?:_?[0-9]){2}|2(?:_?[0-4])(?:_?[0-9])|2(?:_?5)(?:_?[0-6])|0[bB]_?(?:(?:0_?)*0(?:_?0)*|(?:0_?)*1(?:_?[01]){0,7}|(?:0_?)*1_?0_?0_?0_?0_?0_?0_?0_?0)|0[oO]_?(?:(?:0_?)*0(?:_?0)*|(?:0_?)*[1-3](?:_?[0-7]){0,2}|(?:0_?)*4_?0_?0)|0[xX]_?(?:(?:0_?)*0(?:_?0)*|(?:0_?)*[1-9a-fA-F](?:_?[0-9a-fA-F])?|(?:0_?)*1_?0_?0))$"))))
          (language python
            (comparison :right
              (numeric_literal
                (text/regex "^(?:0|[1-9](?:_?[0-9])?|1(?:_?[0-9]){2}|2(?:_?[0-4])(?:_?[0-9])|2(?:_?5)(?:_?[0-6])|0[bB]_?(?:(?:0_?)*0(?:_?0)*|(?:0_?)*1(?:_?[01]){0,7}|(?:0_?)*1_?0_?0_?0_?0_?0_?0_?0_?0)|0[oO]_?(?:(?:0_?)*0(?:_?0)*|(?:0_?)*[1-3](?:_?[0-7]){0,2}|(?:0_?)*4_?0_?0)|0[xX]_?(?:(?:0_?)*0(?:_?0)*|(?:0_?)*[1-9a-fA-F](?:_?[0-9a-fA-F])?|(?:0_?)*1_?0_?0))$")))))))))
