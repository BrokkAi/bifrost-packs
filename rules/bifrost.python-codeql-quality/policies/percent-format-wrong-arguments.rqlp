; CodeQL: python/ql/src/Expressions/WrongNumberArgumentsForFormat.ql
; Source commit: ae741615f3e178ce61289a651790dc67fcc18e19
; Contract: flag parsed percent-format operations whose conversion count differs
; from the supported positional argument count.
(policy
  :schema-version 1
  :id "bifrost.python-codeql-quality.percent-format-wrong-arguments"
  :name "Python percent format argument count"
  :message "The number of values does not match the percent format."
  :severity error
  :description "Finds supported percent-format operations whose parsed positional conversion count differs from the right operand's known argument count."
  :tags ["python" "codeql" "quality" "correctness"]
  :analysis (analysis
    :type match
    :selector (rql :schema-version 1
      (filter :where
        ((relation eq percent_format_wrong_arguments)
         (outcome eq issue)
         (proof eq proven)
         (completeness eq complete))
        (python-format-issues
          (language python (binary_expression)))))))
