        "typescript"
      ],
      "required_capabilities": [
        "structural-match",
        "language-rule-facts",
        "expression-kind-facts"
      ],
      "severity_rationale": "Duplicate object properties hide an earlier value and can make configuration or data construction order-dependent.",
      "remediation": "Remove the duplicate key or make the intended final value explicit."
    },
