      ],
      "required_capabilities": [
        "structural-match",
        "language-rule-facts",
        "lexical-environment"
      ],
      "severity_rationale": "A later initializer that immediately overwrites a sibling value makes declaration intent ambiguous.",
      "remediation": "Use distinct names or combine the declaration so each initializer has one clear purpose."
    },
