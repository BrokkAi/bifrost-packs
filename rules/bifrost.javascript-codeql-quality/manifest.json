        "typescript"
      ],
      "required_capabilities": [
        "structural-match",
        "language-rule-facts",
        "lexical-environment"
      ],
      "severity_rationale": "A default parameter that calls a nested function before initialization can fail at call time.",
      "remediation": "Move the helper declaration or call it after initialization through an explicit parameter or function body."
    },
