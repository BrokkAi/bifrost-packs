        "typescript"
      ],
      "required_capabilities": [
        "structural-match",
        "language-rule-facts",
        "lexical-environment"
      ],
      "severity_rationale": "An unqualified class-owned call can resolve differently from the intended instance member.",
      "remediation": "Use this.member(...) when the call targets the current instance."
    },
