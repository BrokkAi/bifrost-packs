      ],
      "required_capabilities": [
        "structural-match",
        "language-rule-facts",
        "lexical-environment"
      ],
      "severity_rationale": "A likely misspelled identifier can silently refer to the wrong binding or API member.",
      "remediation": "Correct the identifier spelling and update references consistently."
