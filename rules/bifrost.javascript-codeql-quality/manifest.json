        "typescript"
      ],
      "required_capabilities": [
        "structural-match",
        "language-rule-facts",
        "lexical-environment"
      ],
      "severity_rationale": "Duplicate declarations in one lexical scope obscure binding intent and can change runtime behavior.",
      "remediation": "Remove the duplicate declaration or move it to the intended scope."
    },
    {
