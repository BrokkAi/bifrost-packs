        "typescript"
      ],
      "required_capabilities": [
        "structural-match",
        "language-rule-facts",
        "lexical-environment"
      ],
      "severity_rationale": "An assignment without a declaration can create or mutate implicit global state.",
      "remediation": "Declare the variable with the intended let, const, or var binding; review dynamic-scope boundaries separately."
    },
    {
