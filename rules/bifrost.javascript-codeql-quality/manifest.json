  "name": "Bifrost JavaScript CodeQL quality",
  "description": "Public JavaScript and TypeScript declaration, binding, class, property, and identifier quality policies aligned with reviewed CodeQL query identities and engine fact contracts.",
  "policies": [
    {
      "path": "policies/function-declaration-conflict.rqlp",
      "id": "bifrost.javascript-codeql-quality.function-declaration-conflict",
