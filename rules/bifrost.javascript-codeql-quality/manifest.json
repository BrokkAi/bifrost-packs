        "typescript"
      ],
      "required_capabilities": [
        "structural-match",
        "language-rule-facts",
        "member-resolution"
      ],
      "severity_rationale": "A this-member access with mismatched staticness can target no valid class member.",
      "remediation": "Use the matching static or instance form and keep the declaration and access conventions consistent."
    },
    {
      "path": "policies/overwritten-property.rqlp",
      "id": "bifrost.javascript-codeql-quality.overwritten-property",
