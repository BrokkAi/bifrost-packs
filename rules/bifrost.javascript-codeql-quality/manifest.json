      "category": "correctness",
      "supported_languages": [
        "javascript",
        "typescript"
      ],
      "required_capabilities": [
        "structural-match",
        "language-rule-facts",
        "lexical-environment"
      ],
      "severity_rationale": "Conflicting same-name function declarations can change which implementation a lexical binding resolves to.",
      "remediation": "Rename one function or separate the declarations into intentional scopes."
    },
    {
      "path": "policies/variable-redeclaration.rqlp",
      "id": "bifrost.javascript-codeql-quality.variable-redeclaration",
