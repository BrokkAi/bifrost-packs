      "supported_languages": [
        "javascript"
      ],
      "required_capabilities": [
        "structural-match",
        "lexical-environment"
      ],
      "severity_rationale": "Browser alert pauses user interaction and is usually accidental in production code.",
      "remediation": "Use an application notification or an intentional user-interface mechanism instead of a blocking alert."
    },
