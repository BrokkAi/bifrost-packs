(policy
  :schema-version 1
  :id "bifrost.cpp-jsf.av-rule-108"
  :name "JSF AV Rule 108"
  :message "function has variable arguments"
  :severity warning
  :description "Mirrors CodeQL cpp/jsf/av-rule-108 (cpp/ql/src/jsf/4.13 Functions/AV Rule 108.ql) at CodeQL commit ae741615f3e178ce61289a651790dc67fcc18e19. A repeated parameter in a defined callable is a JSF review finding."
  :tags ["cpp" "jsf" "codeql-cpp-jsf-av-rule-108"]
  :analysis (analysis
    :type assertion
    (bind :name signature
      :query (rql :schema-version 1
        (filter :where ((repeated eq true)
                        (coverage eq exact)
                        (declaration_only eq false)
                        (role in [function method constructor]))
          (language cpp
            (callable-signature
              (enclosing-decl (callable)))))))
    (group :name by-signature :by (signature.id)
      (aggregate :name violations :op count))
    (assert :group by-signature :value violations :cardinality (exactly 0))))
