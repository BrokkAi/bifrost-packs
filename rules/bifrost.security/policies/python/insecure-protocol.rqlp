; CodeQL query: python/ql/src/Security/CWE-327/InsecureProtocol.ql
; CodeQL commit: ae741615f3e178ce61289a651790dc67fcc18e19
; Contract: explicit SSLv2, SSLv3, TLSv1.0, and TLSv1.1 selections are reported
; at exact ssl.wrap_socket and ssl.SSLContext constructor calls.
(policy
  :schema-version 1
  :id "bifrost.security.python.insecure-protocol"
  :name "Python insecure SSL/TLS protocol"
  :message "An SSL API selects an obsolete protocol"
  :severity warning
  :description "Reports explicit obsolete SSL/TLS constants passed to the protocol parameter of exact standard-library SSL APIs."
  :tags ["security" "python" "tls" "cwe-327"]
  :analysis (analysis
    :type assertion
    (bind :name explicit-insecure-protocols :query
      (rql :schema-version 1
        (union
          (resolved-value
            :resolves-to "ssl.PROTOCOL_SSLv2"
            :proof exact
            (call-argument :formal-name "ssl_version"
              (resolved-call
                :resolves-to "ssl.wrap_socket"
                :proof exact
                (call-bindings
                  (call-shape (language python (call)))))))
          (resolved-value
            :resolves-to "ssl.PROTOCOL_SSLv3"
            :proof exact
            (call-argument :formal-name "ssl_version"
              (resolved-call
                :resolves-to "ssl.wrap_socket"
                :proof exact
                (call-bindings
                  (call-shape (language python (call)))))))
          (resolved-value
            :resolves-to "ssl.PROTOCOL_TLSv1"
            :proof exact
            (call-argument :formal-name "ssl_version"
              (resolved-call
                :resolves-to "ssl.wrap_socket"
                :proof exact
                (call-bindings
                  (call-shape (language python (call)))))))
          (resolved-value
            :resolves-to "ssl.PROTOCOL_TLSv1_1"
            :proof exact
            (call-argument :formal-name "ssl_version"
              (resolved-call
                :resolves-to "ssl.wrap_socket"
                :proof exact
                (call-bindings
                  (call-shape (language python (call)))))))
          (resolved-value
            :resolves-to "ssl.PROTOCOL_SSLv2"
            :proof exact
            (call-argument :formal-name "protocol"
              (resolved-call
                :resolves-to "ssl.SSLContext.__init__"
                :proof exact
                (call-bindings
                  (call-shape (language python (call)))))))
          (resolved-value
            :resolves-to "ssl.PROTOCOL_SSLv3"
            :proof exact
            (call-argument :formal-name "protocol"
              (resolved-call
                :resolves-to "ssl.SSLContext.__init__"
                :proof exact
                (call-bindings
                  (call-shape (language python (call)))))))
          (resolved-value
            :resolves-to "ssl.PROTOCOL_TLSv1"
            :proof exact
            (call-argument :formal-name "protocol"
              (resolved-call
                :resolves-to "ssl.SSLContext.__init__"
                :proof exact
                (call-bindings
                  (call-shape (language python (call)))))))
          (resolved-value
            :resolves-to "ssl.PROTOCOL_TLSv1_1"
            :proof exact
            (call-argument :formal-name "protocol"
              (resolved-call
                :resolves-to "ssl.SSLContext.__init__"
                :proof exact
                (call-bindings
                  (call-shape (language python (call))))))))))
    (group :name by-call :by (explicit-insecure-protocols.site_id)
      (aggregate :name insecure-protocols :op count))
    (assert :group by-call :value insecure-protocols :cardinality (exactly 0))))
