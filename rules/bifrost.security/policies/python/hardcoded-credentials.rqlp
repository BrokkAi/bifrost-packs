; CodeQL query: python/ql/src/Security/CWE-798/HardcodedCredentials.ql
; CodeQL commit: ae741615f3e178ce61289a651790dc67fcc18e19
; Engine contract: Long in-function literals reaching exact HMAC, SMTP, or FTP credential formals are reported; short literals and unrelated hashing calls are clean.
(policy
  :schema-version 1
  :id "bifrost.security.python.hardcoded-credentials"
  :name "Python hard-coded standard-library credentials"
  :message "A long hard-coded literal reaches a standard-library credential parameter"
  :severity error
  :description "Tracks long in-function literals to the exact hmac.new key, SMTP and FTP login credentials, and the FTP constructor password parameter."
  :tags ["security" "python" "credential" "hardcoded"]
  :analysis (analysis
    :type taint
    :mode may
    :call-modeling (call-modeling :unmodeled require-model)
    :sources (endpoint-set :entries [
      (source :id long-literal
        :display-name "long hard-coded literal"
        :categories [data.hardcoded]
        :selector (rql :schema-version 1
          (language python (inside (function) (string_literal :text/regex "^.{10,}$"))))
        :bind matched-value
        :labels [hardcoded])])
    :sinks (endpoint-set :entries [
      (sink :id hmac-key :display-name "HMAC key" :categories [credential.secret]
        :selector (rql :schema-version 1
          (call-argument :formal-name "key"
            (resolved-call :resolves-to "hmac.new" :proof exact
              (call-bindings (call-shape (language python (call :callee (name/regex "^(new|hmac_new)$"))))))))
        :dangerous-operand (argument :index 0)
        :accepts [hardcoded])
      (sink :id smtp-password :display-name "SMTP password" :categories [credential.secret]
        :selector (rql :schema-version 1
          (call-argument :formal-name "password"
            (resolved-call :resolves-to "smtplib.SMTP.login" :proof exact
              (call-bindings (call-shape (language python (call :callee (name "login"))))))))
        :dangerous-operand (argument :index 1)
        :accepts [hardcoded])
      (sink :id ftp-password :display-name "FTP password" :categories [credential.secret]
        :selector (rql :schema-version 1
          (call-argument :formal-name "passwd"
            (resolved-call :resolves-to "ftplib.FTP.login" :proof exact
              (call-bindings (call-shape (language python (call :callee (name "login"))))))))
        :dangerous-operand (argument :index 1)
        :accepts [hardcoded])
      (sink :id ftp-constructor-password :display-name "FTP constructor password" :categories [credential.secret]
        :selector (rql :schema-version 1
          (filter :where ((name eq "passwd"))
            (call-arguments
              (call-argument-groups
                (filter :where ((resolved_external_callee eq "ftplib.FTP"))
                  (exact-external-callee (call-shape (language python (call)))))))))
        :dangerous-operand matched-value
        :accepts [hardcoded])
      ]))
  :classification (classification
    :fallback (classification-id :taxonomy "CWE" :id "798")))
