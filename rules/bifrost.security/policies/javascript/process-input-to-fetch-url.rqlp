; Lead: BrokkAi/bifrost-packs#478 (CVE-2025-27152), the global fetch part.
; Product source contract: the global fetch(input[, init]) sends a request to
; whatever URL its input names (WHATWG Fetch Standard). A process argument that
; reaches the input chooses the host, port, path and scheme of an outbound
; request, so the program can be pointed at internal services (CWE-918) on
; every Node release. The axios and undici sinks of the lead need third-party
; npm models, whose public or premium placement is an owner decision (#393).
; Engine contract: the source is a keyed read of the reviewed Node runtime
; process.argv model. The sinks bind exactly to the two members of the
; reviewed bifrost.web-network-javascript 1.1.0 pack, fetch(input) and
; fetch(input, init); 1.0.0 declares only the two-argument form, so with it a
; one-argument call leaves the run inconclusive. Both members have complete
; summaries that carry the input to the returned promise and nothing else, so
; a value sent only in init (a request body or header) is not reported.
; Not covered: process.env, request input, Request objects and new URL(...)
; (no URL constructor model), the axios and undici clients, http.request and
; https.get.
(policy
  :schema-version 1
  :id "bifrost.security.javascript.process-input-to-fetch-url"
  :name "Process argument reaches the fetch URL"
  :message "a process argument reached the URL of a global fetch call"
  :severity warning
  :description "Reports process.argv values that reach the input (URL) argument of the global fetch. Whoever controls the URL chooses the host and path of the outbound request, so the program can be made to reach internal services (server-side request forgery)."
  :tags ["security" "javascript" "ssrf" "cwe-918" "node"]
  :analysis
    (analysis
      :type taint
      :mode may
      :call-modeling (call-modeling :unmodeled require-model)
      :sources
        (endpoint-set
          :entries [
            (source
              :id process-argv-read
              :display-name "process.argv indexed read"
              :categories [input.user-controlled io.external]
              :selector
                (rql
                  :schema-version 1
                  (language javascript
                    (keyed-read-value
                      :runtime node
                      :global process
                      :container argv
                      :key-kind static-index
                      :source-origin pristine_input
                      (field_access :field (name "argv")))))
              :bind matched-value
              :labels [attacker-controlled])])
      :sinks
        (endpoint-set
          :entries [
            (sink
              :id fetch-input
              :display-name "fetch(input) URL"
              :categories [network.request]
              :selector
                (rql
                  :schema-version 1
                  (language javascript
                    (call-argument :formal-index 0
                      (resolved-call
                        :resolves-to member.web-network.javascript.global-this.fetch-1
                        :proof declared
                        (call-bindings
                          (call-shape
                            (call :callee (name "fetch"))))))))
              :dangerous-operand (argument :index 0)
              :accepts [attacker-controlled])
            (sink
              :id fetch-input-with-init
              :display-name "fetch(input, init) URL"
              :categories [network.request]
              :selector
                (rql
                  :schema-version 1
                  (language javascript
                    (call-argument :formal-index 0
                      (resolved-call
                        :resolves-to member.web-network.javascript.global-this.fetch
                        :proof declared
                        (call-bindings
                          (call-shape
                            (call :callee (name "fetch"))))))))
              :dangerous-operand (argument :index 0)
              :accepts [attacker-controlled])]))
  :classification
    (classification
      :fallback (classification-id :taxonomy "CWE" :id "918")))
