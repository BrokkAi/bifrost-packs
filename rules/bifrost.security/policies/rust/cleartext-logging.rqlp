        :bind matched-value :labels [sensitive])
      (source :id sensitive-call
        :display-name "Sensitive call value (CodeQL names)"
        :categories [data.sensitive]
        :selector (rql :schema-version 1 (except (union (language rust (call :callee (name/regex "(?:(?is:(?:(?:^|.*[^s_]|(?:^|.*[^i])s|(?:^|.*[^s]|(?:^|.*[^i])s)_)secret.*|(?:^|.*[^n_s]|(?:^|.*[^u])n|(?:^|.*[^ns]|(?:^|.*[^u])n|(?:^|.*[^i])s)_|(?:^|.*[^i])s)trusted(?:$|[^_].*|_(?:$|[^i].*|i(?:$|[^t].*|t(?:$|[^e].*|e(?:$|[^r].*)))))|.*confidential.*))|(?:(?is:.*(?:acc(ou)?nt|puid|user.?(?:name|id)|session.?(id|key)).*)|(?s:.*(?:[uU][uU][iI][dD]|(?:^|_)[uU][iI][dD]|[a-z]U[iI][dD]).*))|(?is:.*(?:pass(?:wd|word|code|.?phrase)(?:(?:(?:(?:(?:(?:(?:(?:(?:e|i)|n)|o)|s)|t)|u)|[^einoqstu])|q(?:(?:q|u(?:q|e(?:q|s(?:q|t(?:q|i(?:q|oq)))))))*(?:(?:(?:(?:(?:(?:(?:e|i)|n)|o)|s)|t)|[^einoqstu])|u(?:(?:(?:(?:(?:(?:(?:i|n)|o)|s)|t)|u)|[^einoqstu])|e(?:(?:(?:(?:(?:(?:(?:e|i)|n)|o)|t)|u)|[^einoqstu])|s(?:(?:(?:(?:(?:(?:(?:e|i)|n)|o)|s)|u)|[^einoqstu])|t(?:(?:(?:(?:(?:(?:(?:e|n)|o)|s)|t)|u)|[^einoqstu])|i(?:(?:(?:(?:(?:(?:(?:e|i)|n)|s)|t)|u)|[^einoqstu])|o(?:(?:(?:(?:(?:(?:e|i)|o)|s)|t)|u)|[^einoqstu])))))))))*(?:|q(?:(?:q|u(?:q|e(?:q|s(?:q|t(?:q|i(?:q|oq)))))))*(?:|u(?:|e(?:|s(?:|t(?:|i(?:|o)))))))|auth(?:entication|ori[sz]ation)?.?key.*|oauth.*|api.?(?:key|tok).*|(?:[_-]|\\b)mfa(?:[_-]|\\b).*))|(?is:.*(?:social.?security|employer.?identification|national.?insurance|resident.?id|passport.?(num|no)|(?:[_-]|\\b)ssn(?:[_-]|\\b)|post.?code|zip.?code|home.?addr|(mob(ile)?|home).?(num|no|tel|phone)|(tel|fax|phone).?(num|no)|telephone|emergency.?contact|latitude|longitude|nationality|(credit|debit|bank|visa).?(card|num|no|acc(ou)?nt)|(card|acc(ou)?nt).?(no|num|credit)|routing.?num|salary|billing|beneficiary|credit.?(rating|score)|(?:[_-]|\\b)(ccn|cvv|iban)(?:[_-]|\\b)|security.?code|birth.?da(te|y)|da(te|y).?(of.?)?birth|gender|(?:[_-]|\\b)sex(?:[_-]|\\b)|medical|(health|care).?plan|healthkit|appointment|prescription|patient.?(id|record)|blood.?(type|alcohol|glucose|pressure)|heart.?(rate|rhythm)|body.?(mass|fat)|menstrua|pregnan|insulin|inhaler|employ(er|ee)|spouse|maiden.?name|mac.?addr).*))