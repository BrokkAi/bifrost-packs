; CVE-2022-46176: Cargo before the one bundled with Rust 1.66.1 does not
; verify the SSH host key when its built-in git support fetches a git
; dependency over SSH. https://blog.rust-lang.org/2023/01/10/cve-2022-46176/
;
; The rule joins two kinds of dependency evidence of the same Cargo package,
; through `declared_by`:
; - a locked Cargo dependency whose source is `git+ssh://`. Locked rows cover
;   transitive dependencies too, and give one finding per locked package.
; - a `rust-toolchain` row whose pinned release is before 1.66.1.
;
; A workspace-root `.cargo/config.toml` that sets `net.git-fetch-with-cli` to
; the boolean `true` makes Cargo fetch with the git command line, which
; verifies host keys, so it suppresses the finding. Cargo reads the config in
; the directory it runs in and every parent, so the root file applies to every
; package under the root. Cargo reads `.cargo/config.toml` only from 1.39.0, so
; the suppression applies only to a pinned release from 1.39.0. A
; `.cargo/config.toml` in a subdirectory takes precedence when Cargo runs
; there, so one that sets the key to anything but `true` keeps the finding.
; RQL has no relation from a configuration file to a Cargo package, so the
; rule left-joins the toolchain row to the same row restricted to 1.39.0 and
; later, then to the package's declared dependencies on `declared_by`, then to
; their `Cargo.toml` document row on `path`, then to both configuration facts
; on `format`; the document row only carries the `format` field that pairs it
; with the facts. The first assertion counts rows with no root fact; the second
; counts rows with a root fact and a nearer override, so the two never report
; the same row.
;
; Incomplete evidence stays incomplete:
; - No toolchain file, a channel such as `stable`, `nightly-…` or `1.65`, or
;   only a `rust-version` minimum gives no exact release. The version
;   predicate is unresolved and the run is inconclusive, never clean.
; - A missing `Cargo.lock` leaves the declaration-to-lock association
;   unresolved, so the run is inconclusive.
;
; Not read: `$CARGO_HOME/config.toml`, a `.cargo/config.toml` above the root,
; the legacy extensionless `.cargo/config` (which Cargo prefers over
; `.cargo/config.toml` in the same directory), `CARGO_NET_GIT_FETCH_WITH_CLI`,
; git `insteadOf` rewrites, rustup overrides and `RUSTUP_TOOLCHAIN`, and
; independently patched Cargo builds. Any of these can change the outcome,
; including turning a suppressed root `true` back into the built-in fetcher.
; SSH registry indexes are not covered.
(policy
  :schema-version 1
  :id "bifrost.security.rust.cargo-ssh-git-host-key-unverified"
  :name "SSH git dependency fetched by a Cargo that skips host-key checks"
  :message "the pinned Rust toolchain predates 1.66.1, whose Cargo fetches this SSH git dependency without verifying the host key (CVE-2022-46176)"
  :severity warning
  :description "Reports a locked Cargo dependency with a git+ssh source in a package whose rust-toolchain file pins a Rust release before 1.66.1. Cargo's built-in git support in those releases does not verify the SSH host key, so a network attacker can serve the dependency. A workspace-root .cargo/config.toml that sets net.git-fetch-with-cli = true suppresses the finding for a pinned Rust 1.39.0 or later, unless a .cargo/config.toml in a subdirectory sets it to anything else. An unpinned toolchain or a missing Cargo.lock leaves the run inconclusive. Ambient Cargo and git configuration is not read."
  :help-uri "https://blog.rust-lang.org/2023/01/10/cve-2022-46176/"
  :tags ["security" "rust" "cargo" "supply-chain" "cve-2022-46176" "cwe-322"]
  :analysis (analysis
    :type assertion
    (bind :name dependency
      :query (rql :schema-version 1
        (filter :where ((source regex "^git\\+ssh://"))
          (dependency-evidence :ecosystem cargo :kinds [locked]))))
    (bind :name toolchain
      :query (rql :schema-version 1
        (dependency-evidence :ecosystem rust-toolchain :version-range "<1.66.1")))
    (bind :name fetch-with-cli
      :query (rql :schema-version 1
        (filter :where ((path eq ".cargo/config.toml"))
          (configuration-facts :format toml
            :route [[(key "net") (key "git-fetch-with-cli")]]
            :scalar-kind boolean :value "true"))))
    (bind :name nearer-override
      :query (rql :schema-version 1
        (filter :where ((path regex "/\\.cargo/config\\.toml$") (value ne "true"))
          (configuration-facts :format toml
            :route [[(key "net") (key "git-fetch-with-cli")]]))))
    (bind :name config-toml-toolchain
      :query (rql :schema-version 1
        (dependency-evidence :ecosystem rust-toolchain :version-range ">=1.39.0, <1.66.1")))
    (bind :name manifest-dependency
      :query (rql :schema-version 1
        (dependency-evidence :ecosystem cargo :kinds [declared])))
    (bind :name manifest-file
      :query (rql :schema-version 1
        (configuration-facts :format toml :node-kind document)))
    (join :left dependency :right toolchain :on ((declared_by declared_by)))
    (join :left toolchain :right config-toml-toolchain :kind left :on ((id id)))
    (join :left config-toml-toolchain :right manifest-dependency :kind left :on ((declared_by declared_by)))
    (join :left manifest-dependency :right manifest-file :kind left :on ((path path)))
    (join :left manifest-file :right fetch-with-cli :kind left :on ((format format)))
    (join :left manifest-file :right nearer-override :kind left :on ((format format)))
    (group :name locked-ssh-dependency :by (dependency.id)
      (aggregate :name affected-toolchains :op count
        :where ((fetch-with-cli.id is-null)))
      (aggregate :name overridden-toolchains :op count
        :where ((fetch-with-cli.id is-not-null) (nearer-override.id is-not-null))))
    (assert :group locked-ssh-dependency :value affected-toolchains :cardinality (exactly 0))
    (assert :group locked-ssh-dependency :value overridden-toolchains :cardinality (exactly 0)))
  :classification (classification
    :fallback (classification-id :taxonomy "CWE" :id "322")))
