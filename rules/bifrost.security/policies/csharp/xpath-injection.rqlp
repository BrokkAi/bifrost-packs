; CodeQL query: csharp/ql/src/Security Features/CWE-643/XPathInjection.ql
; CodeQL commit: ae741615f3e178ce61289a651790dc67fcc18e19
; Product source contract: System.Environment.GetEnvironmentVariable is the public BCL external-input
; source. ASP.NET and System.Web sources are intentionally outside this pack.
(policy
  :schema-version 1
  :id "bifrost.security.csharp.xpath-injection"
  :name "C# XPath injection"
  :message "external input reaches XPathNavigator.Select"
  :severity error
  :description "Mirrors CodeQL csharp/ql/src/Security Features/CWE-643/XPathInjection.ql at commit ae741615f3e178ce61289a651790dc67fcc18e19. Reports Environment.GetEnvironmentVariable data reaching the exact XPathNavigator.Select expression operand."
  :tags ["security" "csharp" "codeql" "xpath-injection" "cwe-643"]
  :analysis
    (analysis
      :type taint
      :mode may
      :call-modeling (call-modeling :unmodeled require-model)
      :sources
        (endpoint-set
          :entries [
            (source
              :id environment-get-environment-variable
              :display-name "Environment.GetEnvironmentVariable external input"
              :categories [input.user-controlled io.external]
              :selector
                (rql
                  :schema-version 1
                  (language csharp
                    (resolved-call
                      :resolves-to "System.Environment.GetEnvironmentVariable"
                      :proof declared
                      (call-bindings
                        (call-shape
                          (call :callee (name "GetEnvironmentVariable") :arity 1))))))
              :bind return-value
              :labels [untrusted])])
      :sinks
        (endpoint-set
          :entries [
            (sink
              :id xpath-expression
              :display-name "XPathNavigator.Select expression"
              :categories [data.xpath]
              :selector
                (rql
                  :schema-version 1
                  (language csharp
                    (call-argument :formal-index 0
                      (resolved-call
                        :resolves-to "System.Xml.XPath.XPathNavigator.Select"
                        :proof declared
                        (call-bindings
                          (call-shape
                            (call :callee (name "Select") :arity 1)))))))
              :dangerous-operand (argument :index 0)
              :accepts [untrusted])]))
  :classification
    (classification
      :fallback (classification-id :taxonomy "CWE" :id "643")))
