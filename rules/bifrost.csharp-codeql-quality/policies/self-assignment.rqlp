; CodeQL: csharp/ql/src/Likely Bugs/SelfAssignment.ql
; CodeQL commit: ae741615f3e178ce61289a651790dc67fcc18e19
; Contract: report a simple `=` assignment whose two sides are bare
; identifiers that bind to the same local or parameter declaration.
; Equality is by lexical binding identity, not by spelling: each side's
; occurrence is resolved with binding-of and the two binding ids must match.
; Narrowed: fields, properties, indexers, array elements and qualified
; targets (`this.f`, `obj.P`, `a[i]`) are not selected, because the engine
; does not yet resolve their members or prove a property accessor trivial.
(policy
  :schema-version 1
  :id "bifrost.csharp-codeql-quality.self-assignment"
  :name "C# self-assignment"
  :message "this assignment assigns a local or parameter to itself"
  :severity warning
  :description "Mirrors CodeQL csharp/ql/src/Likely Bugs/SelfAssignment.ql at commit ae741615f3e178ce61289a651790dc67fcc18e19, narrowed to locals and parameters. Reports a simple assignment whose bare left and right identifiers resolve to the same lexical binding. Fields, properties, indexers, array elements and member-qualified targets are not selected."
  :tags ["csharp" "codeql" "quality" "correctness"]
  :analysis (analysis :type assertion
    (bind :name writes :query (rql :schema-version 1
      (language csharp
        (assignment :operator (text/regex "^=$") :left (identifier) :right (identifier)))))
    (bind :name targets :query (rql :schema-version 1
      (binding-of
        (occurrences-in :role [value_reference]
          (language csharp
            (assignment :operator (text/regex "^=$") :left (identifier) :right (identifier)))))))
    (bind :name values :query (rql :schema-version 1
      (binding-of
        (occurrences-in :role [value_reference]
          (language csharp
            (assignment :operator (text/regex "^=$") :left (identifier) :right (identifier)))))))
    (join :left writes :right targets :on ((left_ast_id reached_from_ast_id)))
    (join :left writes :right values :on ((right_ast_id reached_from_ast_id)))
    (group :name by-write :by (writes.id)
      (aggregate :name self-assignments :op count
        :where ((targets.id eq values.id))))
    (assert :group by-write :value self-assignments :cardinality (exactly 0))))
