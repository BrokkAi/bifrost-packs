; CodeQL query: javascript/ql/src/Security/CWE-313/PasswordInConfigurationFile.ql
; CodeQL commit: ae741615f3e178ce61289a651790dc67fcc18e19
; Engine contract: report non-empty decoded string values at password-like
; keys in JSON/YAML configuration, excluding package metadata and templates.
(policy
  :schema-version 1
  :id "bifrost.javascript-codeql-quality.password-in-configuration-file"
  :name "JavaScript password in configuration file"
  :message "A password-like configuration value is hard-coded"
  :severity warning
  :description "Mirrors the reviewed CodeQL JavaScript query at commit ae741615f3e178ce61289a651790dc67fcc18e19. Reports non-empty password-like JSON and YAML configuration values while excluding package metadata and templates."
  :tags ["javascript" "codeql" "quality" "security" "configuration"]
  :analysis (analysis
    :type match
    :selector (rql :schema-version 1
      (except
        (except
          (where "**/*.json" "**/*.yaml"
            (configuration-facts
              :format [json yaml]
              :node-kind member
              :role object_member
              :scalar-kind string
              :key ["password" "passwd" "pwd" "secret" "token"]))
          (configuration-facts
            :format [json yaml]
            :node-kind member
            :role object_member
            :scalar-kind string
            :key ["password" "passwd" "pwd" "secret" "token"]
            :value ""))
        (union
          (where "**/package.json"
            (configuration-facts :format json :node-kind member))
          (where "**/*.template.json"
            (configuration-facts :format json :node-kind member)))))))
