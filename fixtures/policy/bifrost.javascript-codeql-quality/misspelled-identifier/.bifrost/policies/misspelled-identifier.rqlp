; CodeQL query: javascript/ql/src/Expressions/MisspelledIdentifier.ql
; CodeQL commit: ae741615f3e178ce61289a651790dc67fcc18e19
; Engine contract: an identifier part is reported only when the run's
; identifier typo table lists it as a known misspelling. This pack ships the
; table (data/identifier-typos.txt, derived from Apache OpenOffice's en-US
; AutoCorrect list); without a table the run is incomplete.
(policy
  :schema-version 1
  :id "bifrost.javascript-codeql-quality.misspelled-identifier"
  :name "JavaScript misspelled identifier"
  :message "an identifier may be misspelled"
  :severity note
  :description "Mirrors the reviewed CodeQL JavaScript query at commit ae741615f3e178ce61289a651790dc67fcc18e19. Reports parts of JavaScript and TypeScript identifiers that the identifier typo table shipped with this pack lists as known misspellings."
  :tags ["javascript" "typescript" "codeql" "quality"]
  :analysis (analysis :type match :selector
    (rql :schema-version 1
      (union
        (language javascript
          (identifier :language-rule "js/misspelled-identifier"))
        (language typescript
          (identifier :language-rule "js/misspelled-identifier"))))))
