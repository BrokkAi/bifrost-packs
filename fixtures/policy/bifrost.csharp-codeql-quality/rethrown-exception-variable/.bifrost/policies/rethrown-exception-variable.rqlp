(policy
  :schema-version 1
  :id "bifrost.csharp-codeql-quality.rethrown-exception-variable"
  :name "C# rethrown exception variable"
  :message "throw statement rethrows its exception variable, losing the original stack trace"
  :severity warning
  :description "Mirrors CodeQL csharp/ql/src/Language Abuse/RethrowException.ql at commit ae741615f3e178ce61289a651790dc67fcc18e19. Reports throw statements that throw the nearest owning catch variable, including parenthesized operands."
  :tags ["csharp" "codeql" "quality" "exceptions"]
  :analysis (analysis
    :type assertion
    (bind :name site
      :query (rql :schema-version 1
        (filter :where ((throw_relation eq caught_variable))
          (failure-handler-state
            (language csharp (throw))))))
    (group :name by-throw :by (site.id)
      (aggregate :name variable-rethrows :op count))
    (assert :group by-throw :value variable-rethrows :cardinality (exactly 0))))
