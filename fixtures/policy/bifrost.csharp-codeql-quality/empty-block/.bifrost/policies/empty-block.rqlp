; Contract: select directly-owned empty branch/loop blocks, excluding comment-only blocks and updated for bodies.
(policy :schema-version 1
  :id "bifrost.csharp-codeql-quality.empty-block"
  :name "C# empty branch and loop blocks"
  :message "branch or loop body is empty"
  :severity warning
