; CodeQL query: csharp/ql/src/Likely Bugs/StringBuilderCharInit.ql
; CodeQL commit: ae741615f3e178ce61289a651790dc67fcc18e19
; Engine contract: the exact modeled constructor carries structured argument
; facts. A character literal is selected by its expression kind; a formal is
; selected only when call-bindings proves csharp_implicit_numeric, whose current
; C# contract is exactly char -> int32. The identifier spelling is not proof.
(policy
  :schema-version 1
  :id "bifrost.csharp-codeql-quality.stringbuilder-initialized-with-character"
  :name "C# StringBuilder initialized with a character"
  :message "StringBuilder receives a character"
  :severity warning
  :description "Mirrors CodeQL csharp/ql/src/Likely Bugs/StringBuilderCharInit.ql at commit ae741615f3e178ce61289a651790dc67fcc18e19. Selects the modeled StringBuilder constructor when a character literal or a parameter with a proven char-to-int32 call conversion reaches its one-argument overload."
  :tags ["csharp" "codeql" "quality" "stringbuilder"]
  :analysis (analysis :type assertion
    (bind :name calls :query (rql :schema-version 1
      (union
        (resolved-call
          :resolves-to "System.Text.StringBuilder.StringBuilder"
          :proof declared
          (filter :where
            ((model_id eq "member.dotnet.bcl-csharp.system-text-stringbuilder.constructor-capacity"))
            (call-bindings
              (call-shape
                (language csharp
                  (call :callee (name "StringBuilder") (arity 1)
                    :args [(character_literal)]))))))
        (resolved-call
          :resolves-to "System.Text.StringBuilder.StringBuilder"
          :proof declared
          (filter :where
            ((model_id eq "member.dotnet.bcl-csharp.system-text-stringbuilder.constructor-capacity")
             (conversion eq csharp_implicit_numeric)
             (conversion_status eq proven)
             (mapping eq exact)
             (formal_index eq 0)
             (coverage eq exhaustive)
             (binding_kind eq positional)
             (actual_count eq 1)
             (bound_count eq 1)
             (terminal eq false))
            (call-bindings
              (call-shape
                (language csharp
                  (call :callee (name "StringBuilder") (arity 1)
                    :args [(identifier)])))))))))
    (group :name by-call :by (calls.site_id)
      (aggregate :name selected-calls :op count))
    (assert :group by-call :value selected-calls :cardinality (exactly 0))))
