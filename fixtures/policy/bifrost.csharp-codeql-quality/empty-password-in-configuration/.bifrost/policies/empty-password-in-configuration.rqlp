; CodeQL query: csharp/ql/src/Configuration/EmptyPasswordInConfigurationFile.ql
; CodeQL commit: ae741615f3e178ce61289a651790dc67fcc18e19
; Engine contract: Reports XML attributes with a case-insensitive password or pwd name and empty decoded value, or whose decoded value contains a password assignment followed by a semicolon. Excludes namespace declaration keys because CodeQL models namespace declarations as XmlNamespace nodes rather than XmlAttribute nodes.
(policy
  :schema-version 1
  :id "bifrost.csharp-codeql-quality.empty-password-in-configuration"
  :name "C# empty password in configuration"
  :message "Do not use empty passwords."
  :severity warning
  :description "Mirrors CodeQL csharp/ql/src/Configuration/EmptyPasswordInConfigurationFile.ql at commit ae741615f3e178ce61289a651790dc67fcc18e19. Reports XML attributes with a case-insensitive password or pwd name and empty decoded value, or whose decoded value contains a password assignment followed by a semicolon. Excludes namespace declaration keys because CodeQL models namespace declarations as XmlNamespace nodes rather than XmlAttribute nodes."
  :tags ["csharp" "codeql" "quality" "security" "configuration"]
  :analysis (analysis
    :type match
    :selector (rql :schema-version 1
      (except
        (union
          (filter :where ((key regex "(?i)^(pwd|password)$") (value eq ""))
            (configuration-facts :format xml :node-kind member :role xml_attribute))
          (filter :where ((value regex "(?is)(pwd|password)\\s*=\\s*;"))
            (configuration-facts :format xml :node-kind member :role xml_attribute)))
        (filter :where ((key regex "^xmlns(?::|$)"))
          (configuration-facts :format xml :node-kind member :role xml_attribute)))))
  :classification (classification :fallback
    (classification-id :taxonomy "CodeQL" :id "cs/empty-password-in-configuration")))
