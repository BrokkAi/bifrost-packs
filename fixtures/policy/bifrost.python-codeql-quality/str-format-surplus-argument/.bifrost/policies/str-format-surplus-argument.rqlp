; CodeQL: python/ql/src/Expressions/Formatting/UnusedArgumentIn3101Format.ql
; Source commit: ae741615f3e178ce61289a651790dc67fcc18e19
; Contract: flag supported str.format calls with proven surplus positional arguments.
(policy
  :schema-version 1
  :id "bifrost.python-codeql-quality.str-format-surplus-argument"
  :name "Python str.format surplus positional argument"
  :message "This format call supplies an unused positional argument."
  :severity warning
  :description "Finds complete, proven Python format-issue rows where the call supplies more positional values than the supported parsed format fields use."
  :tags ["python" "codeql" "quality" "correctness"]
  :analysis (analysis
    :type match
    :selector (rql :schema-version 1
      (filter :where ((relation eq str_format_surplus_argument) (outcome eq issue) (proof eq proven) (completeness eq complete)) (python-format-issues (language python (call)))))))
