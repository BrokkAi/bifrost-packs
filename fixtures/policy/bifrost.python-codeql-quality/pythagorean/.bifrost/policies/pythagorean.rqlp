                            :left (identifier)
                            :right (numeric_literal :integer-value "2"))
                          (binary_expression
                            :operator (text/regex "^\\*$")
                            :left (identifier :capture "left_component")
                            :right (identifier :capture "left_component"))])
                      :right (identifier
                        :local-value (binary_expression
                          :or [
                            (binary_expression
                              :operator (text/regex "^\\*\\*$")
                              :left (identifier)
                              :right (numeric_literal :integer-value "2"))
                            (binary_expression
                              :operator (text/regex "^\\*$")
                              :left (identifier :capture "local_right_component")
                              :right (identifier :capture "local_right_component"))]))))))))
          (exact-external-callee
            (call-shape
              (language python
                (call
                  :callee (identifier)
                  :arity 1
                  :args (
                    (binary_expression
                      :operator (text/regex "^\\+$")
                      :left (identifier
                        :local-value (binary_expression
                          :or [
                            (binary_expression
                              :operator (text/regex "^\\*\\*$")
                              :left (identifier)
                              :right (numeric_literal :integer-value "2"))
                            (binary_expression
                              :operator (text/regex "^\\*$")
                              :left (identifier :capture "local_left_component")
                              :right (identifier :capture "local_left_component"))]))
                      :right (binary_expression
                        :or [
                          (binary_expression
                            :operator (text/regex "^\\*\\*$")
                            :left (identifier)
                            :right (numeric_literal :integer-value "2"))
                          (binary_expression
                            :operator (text/regex "^\\*$")
                            :left (identifier :capture "right_component")
                            :right (identifier :capture "right_component"))])))))))
          (exact-external-callee
            (call-shape
              (language python
                (call
                  :callee (identifier)
                  :arity 1
                  :args (
