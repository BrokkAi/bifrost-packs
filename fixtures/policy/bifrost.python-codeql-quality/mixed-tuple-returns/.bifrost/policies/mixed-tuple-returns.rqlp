; CodeQL: python/ql/src/Functions/ReturnConsistentTupleSizes.ql
; Source commit: ae741615f3e178ce61289a651790dc67fcc18e19
; Contract: report unannotated callables with proven returned tuple values of different arities.
(policy
  :schema-version 1
  :id "bifrost.python-codeql-quality.mixed-tuple-returns"
  :name "Python callable returns tuples of varying lengths"
  :message "callable returns tuples with different lengths"
  :severity warning
  :description "Mirrors CodeQL py/mixed-tuple-returns at ae741615f3e178ce61289a651790dc67fcc18e19. Reports only complete proven tuple-return groups with different arities and no return annotation; supported local tuple aliases are followed."
  :tags ["python" "codeql" "quality" "correctness"]
  :analysis (analysis
    :type match
    :selector (rql :schema-version 1
      (filter :where ((relation eq tuple_return_groups)
                      (mixed_tuple_arities eq true)
                      (annotated eq false)
                      (proof eq proven)
                      (completeness eq complete))
        (tuple-return-groups
          (procedure-of (language python (callable))))))))
