; A Flask request value reaching the URL of urllib.request.urlopen.
;
; Each source is an exact read of a request accessor the reviewed Werkzeug
; model declares: `request.args`, `form`, `cookies` and `headers`, where
; `flask.request` proxies `werkzeug.wrappers.Request`. The read itself is the
; source, so only values that come from the request are tainted. The model's
; `get` and `getlist` summaries carry the taint to their results. Another
; `ImmutableMultiDict` built by the application is not a source. Subscript
; reads (`request.args["q"]`) are not traced yet (bifrost-dev#4651).
; `request.values` is excluded: it is a `CombinedMultiDict`.
; `request.get_json()` is declared but is not a source here, because the call
; through the proxy does not bind exactly yet.
;
; The Flask and Werkzeug packs activate on `pkg:pypi/flask` and
; `pkg:pypi/werkzeug` evidence. Until bifrost-dev#14581 derives that evidence
; from lockfiles, no source binds outside a declared wheel environment.
;
; The sink is formal 0 of the exact reviewed urllib.request.urlopen member.
; A workspace function with the same name is not selected.
(policy
  :schema-version 1
  :id "bifrost.security.python.flask-request-to-urlopen"
  :name "Flask request value reaches urllib.request.urlopen"
  :message "A Flask request value reached the url argument of urllib.request.urlopen"
  :severity error
  :description "Reports Flask request query, form, cookie and header values that reach the url argument of urllib.request.urlopen. urlopen dispatches on the URL scheme, so a request value there can read a local file (file:), reach an internal host, or return a data: URL. Source identity is an exact read of a reviewed Werkzeug Request accessor; sink identity is formal 0 of the exact reviewed urllib.request.urlopen member."
  :help-uri "https://bifrost.brokk.ai/static-analysis-policies/#built-in-security-pack"
  :tags ["security" "python" "flask" "ssrf" "cwe-918"]
  :analysis
    (analysis
      :type taint
      :mode may
      :call-modeling (call-modeling :unmodeled require-model)
      :sources
        (endpoint-set
          :entries [
            (source
              :id request-args
              :display-name "Flask request.args"
              :categories [input.user-controlled io.external]
              :selector
                (rql
                  :schema-version 1
                  (language python
                    (resolved-value
                      :resolves-to "werkzeug.wrappers.Request.args"
                      :proof exact
                      (field_access :field (name "args")))))
              :bind matched-value
              :labels [attacker-controlled])
            (source
              :id request-form
              :display-name "Flask request.form"
              :categories [input.user-controlled io.external]
              :selector
                (rql
                  :schema-version 1
                  (language python
                    (resolved-value
                      :resolves-to "werkzeug.wrappers.Request.form"
                      :proof exact
                      (field_access :field (name "form")))))
              :bind matched-value
              :labels [attacker-controlled])
            (source
              :id request-cookies
              :display-name "Flask request.cookies"
              :categories [input.user-controlled io.external]
              :selector
                (rql
                  :schema-version 1
                  (language python
                    (resolved-value
                      :resolves-to "werkzeug.wrappers.Request.cookies"
                      :proof exact
                      (field_access :field (name "cookies")))))
              :bind matched-value
              :labels [attacker-controlled])
            (source
              :id request-headers
              :display-name "Flask request.headers"
              :categories [input.user-controlled io.external]
              :selector
                (rql
                  :schema-version 1
                  (language python
                    (resolved-value
                      :resolves-to "werkzeug.wrappers.Request.headers"
                      :proof exact
                      (field_access :field (name "headers")))))
              :bind matched-value
              :labels [attacker-controlled])])
      :sinks
        (endpoint-set
          :entries [
            (sink
              :id urlopen-url
              :display-name "urllib.request.urlopen url"
              :categories [network.request]
              :selector
                (rql
                  :schema-version 1
                  (language python
                    (call-argument :formal-index 0
                      (resolved-call
                        :resolves-to member.python.urllib.request.urlopen
                        :proof declared
                        (call-bindings
                          (call-shape
                            (call :callee (name "urlopen"))))))))
              :dangerous-operand (argument :index 0)
              :accepts [attacker-controlled])]))
  :classification
    (classification
      :fallback (classification-id :taxonomy "CWE" :id "918")))
