; Leads: BrokkAi/bifrost-packs#368 (CVE-2026-47240, GHSA-8p34-64r3-mwg8) and
; #369 (CVE-2026-47241, GHSA-c4fp-cxrr-mj66).
; OSV (both): rubygems net-imap introduced 0, fixed 0.5.15; introduced 0.6.0,
; fixed 0.6.4.1.
; Product source contract: Net::IMAP#search and #uid_search (keys), #sort,
; #uid_sort, #thread and #uid_thread (search_keys) and #fetch and #uid_fetch
; (attr) send a String argument verbatim as raw IMAP command text. Affected
; releases send a non-synchronizing literal embedded in that text without
; checking that the server advertised LITERAL+, LITERAL- or IMAP4rev2
; (CVE-2026-47240), and miss zero-length trailing literal markers
; (CVE-2026-47241). A server can then read the rest of the text as further
; commands, or the connection hangs. Array criteria are encoded by the client
; and are not raw text.
; Engine contract: the source is the return value of the reviewed
; member.web-network.ruby.net-http.get. The sinks are the raw-argument formals
; of the commands above as declared by the `affected` shard of
; bifrost.ruby.net-imap, which activates from a Gemfile.lock net-imap version
; before 0.5.15 or from 0.6.0 up to 0.6.4. The `unaffected` shard declares the
; same API for 0.5.15 up to 0.6.0 and for 0.6.5 and later, so those projects
; complete clean. Bifrost 0.15.2 reads the four-segment 0.6.4.1 as 0.6.4 with
; build metadata, so 0.6.4 and 0.6.4.1 activate neither shard and stay
; incomplete. Without a locked net-imap version the run is not clean either.
; Keyword arguments to model members get no target on 0.15.2
; (bifrost-dev#11368), so Net::IMAP.new(host, port: 993, ssl: true) leaves the
; run inconclusive. Server capabilities are runtime state and are not checked.
(policy
  :schema-version 1
  :id "bifrost.security.ruby.network-input-to-net-imap-raw-arguments"
  :name "Network input sent as raw net-imap command text on an affected release"
  :message "A network response reaches a raw IMAP command argument on a net-imap release that sends embedded literals unchecked (CVE-2026-47240, CVE-2026-47241); upgrade net-imap to 0.5.15 or 0.6.4.1, or pass structured criteria"
  :severity warning
  :description "Reports a Net::HTTP.get response body that reaches the raw String argument of Net::IMAP search, uid_search, sort, uid_sort, thread, uid_thread, fetch or uid_fetch in a project whose Gemfile.lock selects net-imap before 0.5.15 or 0.6.0 to 0.6.4. Those releases send an embedded non-synchronizing literal without checking server support (CVE-2026-47240) and miss zero-length trailing literal markers (CVE-2026-47241), so the server can read the rest of the text as new commands or the connection hangs. The version comes from Gemfile.lock; without a locked net-imap version the run is incomplete rather than clean."
  :help-uri "https://github.com/ruby/net-imap/security/advisories/GHSA-8p34-64r3-mwg8"
  :tags ["security" "ruby" "net-imap" "command-injection" "cve-2026-47240" "cve-2026-47241" "cwe-77"]
  :analysis
    (analysis
      :type taint
      :mode may
      :call-modeling (call-modeling :unmodeled require-model)
      :sources
        (endpoint-set
          :entries [
            (source
              :id net-http-get
              :display-name "Net::HTTP.get response body"
              :categories [io.external network.response]
              :selector
                (rql
                  :schema-version 1
                  (language ruby
                    (resolved-call
                      :resolves-to member.web-network.ruby.net-http.get
                      :proof declared
                      (call-bindings
                        (call-shape
                          (call :callee (name "get")))))))
              :bind return-value
              :labels [attacker-controlled])])
      :sinks
        (endpoint-set
          :entries [
            (sink
              :id net-imap-search
              :display-name "Net::IMAP#search keys"
              :categories [command.text network.request]
              :selector
                (rql
                  :schema-version 1
                  (language ruby
                    (call-argument :formal-index 0
                      (resolved-call
                        :resolves-to member.ruby.net-imap.affected.net-imap.search
                        :proof declared
                        (call-bindings
                          (call-shape
                            (call :callee (name "search"))))))))
              :dangerous-operand (argument :index 0)
              :accepts [attacker-controlled])
            (sink
              :id net-imap-uid-search
              :display-name "Net::IMAP#uid_search keys"
              :categories [command.text network.request]
              :selector
                (rql
                  :schema-version 1
                  (language ruby
                    (call-argument :formal-index 0
                      (resolved-call
                        :resolves-to member.ruby.net-imap.affected.net-imap.uid_search
                        :proof declared
                        (call-bindings
                          (call-shape
                            (call :callee (name "uid_search"))))))))
              :dangerous-operand (argument :index 0)
              :accepts [attacker-controlled])
            (sink
              :id net-imap-sort
              :display-name "Net::IMAP#sort search_keys"
              :categories [command.text network.request]
              :selector
                (rql
                  :schema-version 1
                  (language ruby
                    (call-argument :formal-index 1
                      (resolved-call
                        :resolves-to member.ruby.net-imap.affected.net-imap.sort
                        :proof declared
                        (call-bindings
                          (call-shape
                            (call :callee (name "sort"))))))))
              :dangerous-operand (argument :index 1)
              :accepts [attacker-controlled])
            (sink
              :id net-imap-uid-sort
              :display-name "Net::IMAP#uid_sort search_keys"
              :categories [command.text network.request]
              :selector
                (rql
                  :schema-version 1
                  (language ruby
                    (call-argument :formal-index 1
                      (resolved-call
                        :resolves-to member.ruby.net-imap.affected.net-imap.uid_sort
                        :proof declared
                        (call-bindings
                          (call-shape
                            (call :callee (name "uid_sort"))))))))
              :dangerous-operand (argument :index 1)
              :accepts [attacker-controlled])
            (sink
              :id net-imap-thread
              :display-name "Net::IMAP#thread search_keys"
              :categories [command.text network.request]
              :selector
                (rql
                  :schema-version 1
                  (language ruby
                    (call-argument :formal-index 1
                      (resolved-call
                        :resolves-to member.ruby.net-imap.affected.net-imap.thread
                        :proof declared
                        (call-bindings
                          (call-shape
                            (call :callee (name "thread"))))))))
              :dangerous-operand (argument :index 1)
              :accepts [attacker-controlled])
            (sink
              :id net-imap-uid-thread
              :display-name "Net::IMAP#uid_thread search_keys"
              :categories [command.text network.request]
              :selector
                (rql
                  :schema-version 1
                  (language ruby
                    (call-argument :formal-index 1
                      (resolved-call
                        :resolves-to member.ruby.net-imap.affected.net-imap.uid_thread
                        :proof declared
                        (call-bindings
                          (call-shape
                            (call :callee (name "uid_thread"))))))))
              :dangerous-operand (argument :index 1)
              :accepts [attacker-controlled])
            (sink
              :id net-imap-fetch
              :display-name "Net::IMAP#fetch attr"
              :categories [command.text network.request]
              :selector
                (rql
                  :schema-version 1
                  (language ruby
                    (call-argument :formal-index 1
                      (resolved-call
                        :resolves-to member.ruby.net-imap.affected.net-imap.fetch
                        :proof declared
                        (call-bindings
                          (call-shape
                            (call :callee (name "fetch"))))))))
              :dangerous-operand (argument :index 1)
              :accepts [attacker-controlled])
            (sink
              :id net-imap-uid-fetch
              :display-name "Net::IMAP#uid_fetch attr"
              :categories [command.text network.request]
              :selector
                (rql
                  :schema-version 1
                  (language ruby
                    (call-argument :formal-index 1
                      (resolved-call
                        :resolves-to member.ruby.net-imap.affected.net-imap.uid_fetch
                        :proof declared
                        (call-bindings
                          (call-shape
                            (call :callee (name "uid_fetch"))))))))
              :dangerous-operand (argument :index 1)
              :accepts [attacker-controlled])]))
  :classification
    (classification
      :fallback (classification-id :taxonomy "CWE" :id "77")))
