(policy
  :schema-version 1
  :id "bifrost.cpp-jsf.av-rule-13"
  :name "JSF AV Rule 13"
  :message "wide character or string literal requires review"
  :severity error
  :description "Mirrors CodeQL cpp/jsf/av-rule-13 (cpp/ql/src/jsf/4.04 Environment/AV Rule 13.ql) at CodeQL commit ae741615f3e178ce61289a651790dc67fcc18e19. Wide-character literal spellings require portability review."
  :tags ["cpp" "jsf" "codeql-cpp-jsf-av-rule-13"]
  :analysis (analysis
    :type match
    :selector (rql :schema-version 1
      (language cpp (literal (text/regex "^L")))))
  )
