; Lead: BrokkAi/bifrost-packs#451 arm 1 (raphaelvallat/pingouin@790ae3f).
; df["col"].fillna(v, inplace=True) and df.loc[...].method(..., inplace=True)
; update the temporary object that the selection returned. Under pandas
; Copy-on-Write (the default from pandas 3.0) the frame never changes; pandas
; 2.2 warns, and earlier versions update the frame only when the selection
; happens to be a view. The receiver must be a .loc[...] or .iloc[...]
; selection or a subscript with one string-literal key. A list element such
; as frames[i].dropna(inplace=True) is not reported. A dict of frames indexed
; by a string literal, such as frames["train"].dropna(inplace=True), is
; reported, because the receiver type is not resolved.
(policy
  :schema-version 1
  :id "bifrost.correctness.python-pandas-chained-inplace"
  :name "inplace=True on a pandas selection"
  :message "inplace=True on a column or .loc/.iloc selection updates a temporary copy; assign the result back instead."
  :severity warning
  :description "Reports a pandas method that accepts inplace (fillna, replace, clip, where, mask, interpolate, ffill, bfill, dropna, sort_values and similar) called with the literal keyword inplace=True on a .loc[...] or .iloc[...] selection or on a subscript with a single string-literal key, such as df['Time'].fillna('-', inplace=True). The call updates the temporary Series or DataFrame the selection returned. Under Copy-on-Write, the default from pandas 3.0, the original frame never changes; earlier versions update it only when the selection is a view. Assigning the result back, as in df['Time'] = df['Time'].fillna('-'), or a whole-frame call such as df.fillna({'Time': '-'}, inplace=True), is not reported."
  :help-uri "https://bifrost.brokk.ai/static-analysis-policies/#built-in-code-smell-pack"
  :tags ["correctness" "python" "pandas" "code-smell"]
  :analysis (analysis
    :type match
    :selector (rql :schema-version 1
      (language python
        (call
          :callee (name/regex "^(?:fillna|replace|clip|where|mask|interpolate|ffill|bfill|pad|backfill|dropna|drop_duplicates|sort_values|sort_index|rename|drop|reset_index|set_index)$")
          :kwargs [(inplace (boolean_literal :boolean-value true))]
          :receiver (text/regex "(?s)(?:\\.(?:loc|iloc)\\s*\\[.*\\]|\\[\\s*[rRbBuU]?(?:\"[^\"]*\"|\\x27[^\\x27]*\\x27)\\s*\\])$"))))))
